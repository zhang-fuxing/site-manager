{
  "name": "site-manager",
  "private": true,
  "version": "0.0.2",
  "description": "多标签页桌面端网址管理工具：站点标签手动增删改与显隐配置、拖拽排序，以及同站点多账号登录隔离",
  "author": "zhangfx <zhangfuxing1010@163.com>",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5300",
    "build": "npm run typecheck && rimraf dist-electron && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.electron.json",
    "typecheck:app": "vue-tsc --noEmit -p tsconfig.app.json",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "test": "rimraf test/report.txt test/trace.txt && vite build && node scripts/run-tests.mjs",
    "clean": "rimraf dist dist-electron release logs config test/report.txt test/trace.txt",
    "pack:win": "npm run build && electron-builder --win --x64",
    "pack:linux": "npm run build && electron-builder --linux",
    "pack:all": "npm run build && electron-builder --win --linux"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vue-tsc": "^3.3.11"
  },
  "build": {
    "appId": "com.sitemanager.app",
    "productName": "Site Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
