{
  "name": "site-manager",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "clean": "rimraf dist dist-electron release logs config",
    "pack:win": "npm run build && electron-builder --win --x64",
    "pack:linux": "npm run build && electron-builder --linux",
    "pack:all": "npm run build && electron-builder --win --linux"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue-tsc": "^3.3.11"
  },
  "build": {
    "appId": "com.sitemanager.app",
    "productName": "Site Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
